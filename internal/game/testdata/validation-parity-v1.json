{
  "version": 1,
  "cases": [
    {
      "id": "known-valid-root-power",
      "digits": [5, 1, 6, 2, 0, 2, 6],
      "equation": "5+√16=2^0+2+6",
      "mode": "",
      "expectedValid": true,
      "expectedLeft": "9",
      "expectedRight": "9"
    },
    {
      "id": "incomplete-missing-equals",
      "digits": [5, 1, 6],
      "equation": "5+√16",
      "mode": "",
      "expectedValid": false,
      "expectedError": "Equation must contain exactly one equals sign"
    },
    {
      "id": "unequal-sides",
      "digits": [5, 1, 6, 2, 0, 2, 6],
      "equation": "5+1+6=2+0+2+6",
      "mode": "",
      "expectedValid": false,
      "expectedError": "Left side (12) does not equal right side (10)",
      "expectedLeft": "12",
      "expectedRight": "10"
    },
    {
      "id": "out-of-order-digits",
      "digits": [5, 1, 6, 2, 0, 2, 6],
      "equation": "5+√61=2^0+2+6",
      "mode": "",
      "expectedValid": false,
      "expectedError": "Digits must be used in date order"
    },
    {
      "id": "leading-zero-concatenation",
      "digits": [6, 1, 9, 2, 0, 2, 6],
      "equation": "61-9=2*026",
      "mode": "",
      "expectedValid": false,
      "expectedError": "Numbers cannot start with zero"
    },
    {
      "id": "separated-zero-valid",
      "digits": [0, 2, 6, 2, 6],
      "equation": "0+26=26",
      "mode": "",
      "expectedValid": true,
      "expectedLeft": "26",
      "expectedRight": "26"
    },
    {
      "id": "exact-fraction",
      "digits": [1, 3, 1, 3, 2, 3],
      "equation": "1/3+1/3=2/3",
      "mode": "",
      "expectedValid": true,
      "expectedLeft": "0.6̅",
      "expectedRight": "0.6̅"
    },
    {
      "id": "absolute-value",
      "digits": [5, 5],
      "equation": "|5|=5",
      "mode": "",
      "expectedValid": true,
      "expectedLeft": "5",
      "expectedRight": "5"
    },
    {
      "id": "factorial",
      "digits": [3, 6],
      "equation": "3!=6",
      "mode": "",
      "expectedValid": true,
      "expectedLeft": "6",
      "expectedRight": "6"
    },
    {
      "id": "integral-power",
      "digits": [2, 3, 8],
      "equation": "2^3=8",
      "mode": "",
      "expectedValid": true,
      "expectedLeft": "8",
      "expectedRight": "8"
    },
    {
      "id": "division-by-zero",
      "digits": [0, 1, 2],
      "equation": "0^-1=2",
      "mode": "",
      "expectedValid": false,
      "expectedError": "Cannot divide by zero"
    },
    {
      "id": "non-real-root",
      "digits": [1, 1],
      "equation": "√(-1)=1",
      "mode": "",
      "expectedValid": false,
      "expectedError": "Operation is outside supported real-number math"
    },
    {
      "id": "missing-date-digit",
      "digits": [5, 1, 6, 2, 0, 2, 6],
      "equation": "5+√16=2^0+2",
      "mode": "",
      "expectedValid": false,
      "expectedError": "Digits must be used in date order"
    },
    {
      "id": "duplicate-date-digit",
      "digits": [5, 1, 6, 2, 0, 2, 6],
      "equation": "5+√16=2^0+2+6+6",
      "mode": "",
      "expectedValid": false,
      "expectedError": "Digits must be used in date order"
    },
    {
      "id": "multiple-equals",
      "digits": [6, 2, 0, 2, 0, 2, 6],
      "equation": "6=2=0+2+0+2+6",
      "mode": "",
      "expectedValid": false,
      "expectedError": "Equation must contain exactly one equals sign"
    }
  ]
}
